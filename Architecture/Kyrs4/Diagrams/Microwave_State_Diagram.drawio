        <mxCell id="ready-body" value="задатьВремя(секунды) /&#10;    таймер.задатьВремя(секунды)&#10;выбратьМощность(проценты) /&#10;    магнетрон.задатьМощность(проценты)" vertex="1" parent="ready" style="html=0;fontFamily=Arial;fontSize=17;strokeColor=#000000;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=14;whiteSpace=wrap;">
