          <mxGeometry as="geometry" x="970" y="300" width="440" height="180" />
        </mxCell>
        <mxCell id="heating-body" value="entry / магнетрон.включить();&#10;            таймер.запустить()&#10;exit / магнетрон.выключить();&#10;          таймер.остановить()" vertex="1" parent="heating" style="html=0;fontFamily=Arial;fontSize=17;strokeColor=#000000;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=14;whiteSpace=wrap;">
          <mxGeometry as="geometry" x="0" y="44" width="440" height="136" />
        </mxCell>
