          <mxGeometry as="geometry" x="970" y="790" width="440" height="125" />
        </mxCell>
        <mxCell id="paused-body" value="entry / панель.показатьСообщение(«Пауза»)" vertex="1" parent="paused" style="html=0;fontFamily=Arial;fontSize=17;strokeColor=#000000;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=14;whiteSpace=wrap;">
          <mxGeometry as="geometry" x="0" y="44" width="440" height="81" />
        </mxCell>
        <mxCell id="init" value="/ магнетрон.выключить();&#10;  таймер.сбросить()" edge="1" parent="1" source="initial" target="ready" style="html=0;fontFamily=Arial;fontSize=17;strokeColor=#000000;fillColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=17;labelBackgroundColor=#ffffff;align=center;exitX=0.5;exitY=1;entryX=0.15;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="start" value="запустить()&#10;[можноНагревать()]" edge="1" parent="1" source="ready" target="heating" style="html=0;fontFamily=Arial;fontSize=17;strokeColor=#000000;fillColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=17;labelBackgroundColor=#ffffff;align=center;exitX=1;exitY=0.35;entryX=0;entryY=0.42;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="finish" value="обработатьОкончаниеВремени() / таймер.сбросить()" edge="1" parent="1" source="heating" target="ready" style="html=0;fontFamily=Arial;fontSize=17;strokeColor=#000000;fillColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=17;labelBackgroundColor=#ffffff;align=center;exitX=0.5;exitY=0;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1190" y="150" />
              <mxPoint x="320" y="150" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="cancel-heat" value="отменить() / таймер.сбросить()" edge="1" parent="1" source="heating" target="ready" style="html=0;fontFamily=Arial;fontSize=17;strokeColor=#000000;fillColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=17;labelBackgroundColor=#ffffff;align=center;exitX=0;exitY=0.8;entryX=1;entryY=0.8;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="820" y="444" />
              <mxPoint x="820" y="600" />
              <mxPoint x="620" y="600" />
              <mxPoint x="620" y="472" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="pause" value="приостановить()" edge="1" parent="1" source="heating" target="paused" style="html=0;fontFamily=Arial;fontSize=17;strokeColor=#000000;fillColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=17;labelBackgroundColor=#ffffff;align=center;exitX=0.15;exitY=1;entryX=0.15;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="door" value="обработатьОткрытиеДверцы()" edge="1" parent="1" source="heating" target="paused" style="html=0;fontFamily=Arial;fontSize=17;strokeColor=#000000;fillColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=17;labelBackgroundColor=#ffffff;align=center;exitX=0.85;exitY=1;entryX=0.85;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="resume" value="возобновить()&#10;[можноНагревать()]" edge="1" parent="1" source="paused" target="heating" style="html=0;fontFamily=Arial;fontSize=17;strokeColor=#000000;fillColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=17;labelBackgroundColor=#ffffff;align=center;exitX=1;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1510" y="853" />
              <mxPoint x="1510" y="390" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="cancel-pause" value="отменить() / таймер.сбросить()" edge="1" parent="1" source="paused" target="ready" style="html=0;fontFamily=Arial;fontSize=17;strokeColor=#000000;fillColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=17;labelBackgroundColor=#ffffff;align=center;exitX=0.5;exitY=1;entryX=0.5;entryY=1;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1190" y="1030" />
              <mxPoint x="320" y="1030" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rules" value="Правила модели&#10;&#10;• можноНагревать(): дверца закрыта и остаток времени &gt; 0.&#10;• Настройка времени и мощности разрешена в «Готовности».&#10;• Если условие перехода ложно, переход не выполняется.&#10;• Закрытие дверцы само по себе не возобновляет нагрев.&#10;• Необрабатываемые в состоянии команды игнорируются.&#10;• В «Паузе» нагрев и отсчёт выключены; время сохранено." vertex="1" parent="1" style="html=0;fontFamily=Arial;fontSize=17;strokeColor=#000000;fillColor=#ffffff;shape=note;size=18;align=left;verticalAlign=top;spacing=14;whiteSpace=wrap;fontSize=17;">
          <mxGeometry as="geometry" x="80" y="690" width="610" height="245" />
        </mxCell>
        <mxCell id="legend" value="Подпись перехода: событие [условие] / действие.&#10;entry — действие при входе в состояние; exit — при выходе.&#10;Модель описывает работу после включения питания; конечное состояние не требуется." vertex="1" parent="1" style="html=0;fontFamily=Arial;fontSize=17;strokeColor=#000000;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontSize=17;">
          <mxGeometry as="geometry" x="80" y="1070" width="1400" height="65" />
        </mxCell>
