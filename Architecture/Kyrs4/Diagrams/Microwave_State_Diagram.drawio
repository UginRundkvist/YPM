        </mxCell>
        <mxCell id="ready" value="Готовность" vertex="1" parent="1" style="html=0;fontFamily=Arial;fontSize=17;strokeColor=#000000;fillColor=#ffffff;swimlane;rounded=1;arcSize=15;startSize=44;horizontal=1;collapsible=0;align=center;fontSize=22;fontStyle=1;">
